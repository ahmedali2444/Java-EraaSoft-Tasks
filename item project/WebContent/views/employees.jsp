<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,models.Employee" %>
<%! String h(String v){return v==null?"":v.replace("&","&amp;").replace("\"","&quot;").replace("<","&lt;").replace(">","&gt;");} %>
<% List<Employee> employees=(List<Employee>)request.getAttribute("employees"); Employee current=(Employee)session.getAttribute("currentUser"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Employees - Item Project</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/app-layout.css"></head>
<body class="app-body"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><header class="page-header"><div><span class="page-kicker">Access control</span><h1>Employees</h1><p>Manage dashboard access and operation permissions.</p></div><button class="primary-button compact" data-modal-open="employeeModal">Add employee</button></header><% if(request.getAttribute("message")!=null){ %><div class="alert"><%=h(String.valueOf(request.getAttribute("message")))%></div><% } %><section class="table-card"><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Phone</th><th>Role</th><th>Status</th><th>Permissions</th><th>Actions</th></tr></thead><tbody><% for(Employee e:employees){ %><tr><td><div class="product-cell"><span><%=h(e.name.substring(0,1).toUpperCase())%></span><div><strong><%=h(e.name)%></strong><small><%=h(e.email)%></small></div></div></td><td><%=h(e.phone)%></td><td><span class="category-pill"><%=e.admin?"Admin":"Employee"%></span></td><td><span class="stock-status <%=e.active?"":"out"%>"><%=e.active?"Active":"Inactive"%></span></td><td><div class="permission-tags"><% if(e.updateProducts){%><span>Product update</span><%}if(e.deleteProducts){%><span>Product delete</span><%}if(e.updateCategories){%><span>Category update</span><%}if(e.deleteCategories){%><span>Category delete</span><%}%></div></td><td><div class="action-row"><button class="icon-action" data-edit-employee data-id="<%=e.id%>" data-name="<%=h(e.name)%>" data-phone="<%=h(e.phone)%>" data-email="<%=h(e.email)%>" data-admin="<%=e.admin%>" data-up="<%=e.updateProducts%>" data-dp="<%=e.deleteProducts%>" data-uc="<%=e.updateCategories%>" data-dc="<%=e.deleteCategories%>" data-active="<%=e.active%>"><svg viewBox="0 0 24 24"><path d="m4 16-1 5 5-1L19 9l-4-4Z"/><path d="m13 7 4 4"/></svg></button><% if(!e.admin&&e.id!=current.id){ %><form method="post" action="<%=request.getContextPath()%>/employees" data-confirm="Remove this employee access?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=e.id%>"><button class="icon-action danger"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14"/></svg></button></form><% } %></div></td></tr><% } %></tbody></table></div></section></main>
<dialog class="modal employee-modal" id="employeeModal"><form method="post" action="<%=request.getContextPath()%>/employees" data-employee-form><input type="hidden" name="id" value="0"><div class="modal-header"><div><span>Dashboard access</span><h2 data-employee-title>Add employee</h2></div><button class="modal-close" type="button" data-modal-close>×</button></div><div class="form-grid"><label>Full name<input name="name" required></label><label>Phone number<input name="phone" placeholder="+201..." required></label><label class="wide">Email<input name="email" type="email" required></label><label class="wide" data-new-password-label>Password<input name="password" type="password" minlength="8"></label></div><fieldset><legend>Permissions</legend><div class="checkbox-grid"><label><input type="checkbox" name="updateProducts">Update products</label><label><input type="checkbox" name="deleteProducts">Delete products</label><label><input type="checkbox" name="updateCategories">Update categories</label><label><input type="checkbox" name="deleteCategories">Delete categories</label><label><input type="checkbox" name="admin">Administrator</label><label><input type="checkbox" name="active" value="true" checked>Active account</label></div></fieldset><div class="modal-actions"><button class="secondary-button" type="button" data-modal-close>Cancel</button><button class="primary-button compact">Save employee</button></div></form></dialog><script src="<%=request.getContextPath()%>/assets/js/main.js"></script></body></html>
