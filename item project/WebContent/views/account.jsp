<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="models.Employee" %><% Employee account=(Employee)session.getAttribute("currentUser"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Account - Item Project</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/app-layout.css"></head>
<body class="app-body"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><header class="page-header"><div><span class="page-kicker">Profile</span><h1>Account</h1><p>Your identity and security settings.</p></div></header><% if(request.getAttribute("message")!=null){ %><div class="alert"><%=request.getAttribute("message")%></div><% } %><section class="account-layout"><article class="profile-card"><div class="profile-avatar"><%=account.name.substring(0,1).toUpperCase()%></div><div><span><%=account.admin?"Administrator":"Employee"%></span><h2><%=account.name%></h2><p><%=account.email%></p></div></article><article class="info-card"><div><span>Full name</span><strong><%=account.name%></strong></div><div><span>Email address</span><strong><%=account.email%></strong></div><div><span>Phone number</span><strong><%=account.phone%></strong></div><div><span>Account status</span><strong><%=account.active?"Active":"Inactive"%></strong></div></article><button class="primary-button compact" data-modal-open="passwordModal">Change password</button></section></main><dialog class="modal" id="passwordModal"><form method="post" action="<%=request.getContextPath()%>/account"><div class="modal-header"><div><span>Security</span><h2>Change password</h2></div><button class="modal-close" type="button" data-modal-close>×</button></div><label>Current password<input name="currentPassword" type="password" required></label><label>New password<input name="newPassword" type="password" minlength="8" required></label><label>Confirm new password<input name="confirmPassword" type="password" minlength="8" required></label><div class="modal-actions"><button class="secondary-button" type="button" data-modal-close>Cancel</button><button class="primary-button compact">Update password</button></div></form></dialog><script src="<%=request.getContextPath()%>/assets/js/main.js"></script></body></html>
