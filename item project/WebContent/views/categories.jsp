<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,models.Category,models.Employee" %>
<%! String h(String v){return v==null?"":v.replace("&","&amp;").replace("\"","&quot;").replace("<","&lt;").replace(">","&gt;");} %>
<% List<Category> categories=(List<Category>)request.getAttribute("categories"); Employee user=(Employee)session.getAttribute("currentUser"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Categories - Item Project</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/app-layout.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/categories-layout.css"></head>
<body class="app-body"><%@ include file="/WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><header class="page-header"><div><span class="page-kicker">Organization</span><h1>Categories</h1><p>Keep your product catalog structured and easy to filter.</p></div><% if(user.admin||user.updateCategories){ %><button class="primary-button compact" data-modal-open="categoryFormModal">Add category</button><% } %></header><% if(request.getAttribute("message")!=null){ %><div class="alert"><%=h(String.valueOf(request.getAttribute("message")))%></div><% } %><section class="table-card"><% if(categories.isEmpty()){ %><div class="empty-state"><div class="empty-icon">+</div><h2>No categories yet</h2><p>Add a category before creating products.</p><% if(user.admin||user.updateCategories){ %><button class="primary-button" data-modal-open="categoryFormModal">Add category</button><% } %></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>ID</th><th>Category name</th><th>Actions</th></tr></thead><tbody><% for(Category c:categories){ %><tr><td>#<%=c.id%></td><td><div class="product-cell"><span><%=h(c.name.substring(0,1).toUpperCase())%></span><strong><%=h(c.name)%></strong></div></td><td><div class="action-row"><% if(user.admin||user.updateCategories){ %><button class="icon-action" data-edit-category data-id="<%=c.id%>" data-name="<%=h(c.name)%>" title="Edit category"><svg viewBox="0 0 24 24"><path d="m4 16-1 5 5-1L19 9l-4-4Z"/><path d="m13 7 4 4"/></svg></button><% } if(user.admin||user.deleteCategories){ %><form method="post" action="<%=request.getContextPath()%>/categories" data-confirm="Delete this category?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=c.id%>"><button class="icon-action danger" title="Delete category"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg></button></form><% } %></div></td></tr><% } %></tbody></table></div><% } %></section></main>
<dialog class="modal" id="categoryFormModal"><form method="post" action="<%=request.getContextPath()%>/categories" data-category-form><input type="hidden" name="action" value="add"><input type="hidden" name="id" value="0"><div class="modal-header"><div><span>Catalog structure</span><h2 data-category-title>Add category</h2></div><button class="modal-close" type="button" data-modal-close>×</button></div><label>Category name<input name="name" maxlength="120" required></label><div class="modal-actions"><button class="secondary-button" type="button" data-modal-close>Cancel</button><button class="primary-button compact">Save category</button></div></form></dialog><script src="<%=request.getContextPath()%>/assets/js/main.js"></script></body></html>
