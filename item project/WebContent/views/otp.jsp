<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify OTP - Item Project</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head>
<body class="auth-body"><main class="otp-page"><section class="auth-card otp-card"><div class="auth-brand"><span>IP</span><strong>Item Project</strong></div><div class="otp-icon"><svg viewBox="0 0 24 24"><path d="M7 10V8a5 5 0 0 1 10 0v2M5 10h14v11H5z"/></svg></div><h2>Check your email</h2><p>Enter the 6-digit code sent to your inbox. It expires in 10 minutes.</p><% if(request.getAttribute("message")!=null){ %><div class="alert"><%=request.getAttribute("message")%></div><% } %><form method="post" action="<%=request.getContextPath()%>/verify-otp"><input class="otp-input" name="otp" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" required><button class="primary-button" type="submit">Verify</button></form><form method="post" action="<%=request.getContextPath()%>/verify-otp"><input type="hidden" name="action" value="resend"><button class="text-button" type="submit">Send a new code</button></form></section></main><script src="<%=request.getContextPath()%>/assets/js/main.js"></script></body></html>
