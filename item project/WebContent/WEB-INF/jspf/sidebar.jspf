<%@ page import="models.Employee" %>
<% Employee sidebarUser=(Employee)session.getAttribute("currentUser"); String context=request.getContextPath(); %>
<button class="menu-button" type="button" data-sidebar-open aria-label="Open menu"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
<div class="sidebar-overlay" data-sidebar-close></div>
<aside class="sidebar" data-sidebar>
    <div class="sidebar-top"><div class="logo-mark">IP</div><button class="icon-button" type="button" data-sidebar-close aria-label="Close menu"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <div class="user-card"><span><%=sidebarUser.admin?"Administrator":"Employee"%></span><strong><%=sidebarUser.name%></strong><small><%=sidebarUser.email%></small></div>
    <nav class="sidebar-nav">
        <a href="<%=context%>/products">Products</a>
        <a href="<%=context%>/categories">Categories</a>
        <% if(sidebarUser.admin){ %><a href="<%=context%>/employees">Employees</a><% } %>
        <a href="<%=context%>/account">Account</a>
    </nav>
    <form class="logout-form" action="<%=context%>/logout" method="post" data-confirm="Sign out from Item Project?"><button type="submit"><svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M14 3h6v18h-6"/></svg>Sign out</button></form>
</aside>
<dialog class="modal confirm-modal" id="confirmModal">
    <div class="confirm-content">
        <div class="confirm-icon"><svg viewBox="0 0 24 24"><path d="M12 8v5M12 17h.01"/><path d="M10.3 3.8 2.5 17.2A2 2 0 0 0 4.2 20h15.6a2 2 0 0 0 1.7-2.8L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg></div>
        <div><span>Confirm action</span><h2>Are you sure?</h2><p data-confirm-message></p></div>
    </div>
    <div class="modal-actions"><button class="secondary-button" type="button" data-confirm-cancel>Cancel</button><button class="danger-button" type="button" data-confirm-approve>Confirm</button></div>
</dialog>
